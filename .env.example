PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hcm_lite
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:5173

# Optional: create the first Admin automatically on an empty database
# (otherwise open the web app and use the First-run setup screen)
# COMPANY_NAME=My Company
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=ChangeMe123

# AI assistant (Google Gemini) - used by the backend only, never the browser
AI_API_KEY=
